{
  "name": "mapcidade-mobile-restore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Restores a mobile-app field backup (tasks.json + attachments) into a city database and re-uploads photos by SFTP. Dry-run by default: builds the INSERT plan and only executes with explicit confirmation.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "ssh2-sftp-client": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/ssh2-sftp-client": "^9.0.4",
    "eslint": "^9.39.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
